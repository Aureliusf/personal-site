---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead title={title} description={description} />
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="page flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Margin notes: tap a number to open its note on narrow screens;
      // hovering or focusing either end lights up the pair on any screen.
      const wide = window.matchMedia('(min-width: 1100px)');

      document.querySelectorAll<HTMLButtonElement>('.note-ref button').forEach((ref) => {
        const note = document.getElementById(ref.dataset.note ?? '');
        if (!note) return;

        ref.addEventListener('click', () => {
          if (wide.matches) return;
          const open = note.classList.toggle('is-open');
          ref.setAttribute('aria-expanded', String(open));
        });

        const light = (on: boolean) => note.classList.toggle('is-lit', on);
        for (const el of [ref, note]) {
          el.addEventListener('mouseenter', () => light(true));
          el.addEventListener('mouseleave', () => light(false));
        }
        ref.addEventListener('focus', () => light(true));
        ref.addEventListener('blur', () => light(false));
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 3px;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
