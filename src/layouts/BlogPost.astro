---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingMinutes, sortedPosts, tagHue } from '../data/site';

type Props = CollectionEntry<'posts'>['data'] & {
  slug: string;
  body?: string;
};

const { title, description, date, tags, github, liveUrl, slug, body } = Astro.props;

const posts = await sortedPosts();
const index = posts.findIndex((p) => p.id === slug);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const minutes = readingMinutes(body);
---

<BaseLayout title={`${title} · Aurelio Florez`} description={description}>
  <article class="post">
    <header class="col post-head">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-dek">{description}</p>}
      <aside class="post-meta small" aria-label="About this post">
        <p><time datetime={date.toISOString()}>{formatDate(date, 'long')}</time> · {minutes} min read</p>
        {tags && tags.length > 0 && (
          <p class="tags">{tags.map((tag) => <a href={`/tags/${tag}`} style={`--c:${tagHue(tag)}`}><span class="swatch" aria-hidden="true" />{tag}</a>)}</p>
        )}
        {(liveUrl || github) && (
          <p class="links">
            {liveUrl && <a class="link" href={liveUrl} rel="noopener noreferrer">Live site</a>}
            {github && <a class="link" href={github} rel="noopener noreferrer">Source</a>}
          </p>
        )}
      </aside>
    </header>

    <div class="col prose post-body">
      <slot />
    </div>
  </article>

  <nav class="col post-nav small" aria-label="More writing">
    {older && (
      <p><span class="muted">Older</span> <a class="link" href={`/posts/${older.id}`}>{older.data.title}</a></p>
    )}
    {newer && (
      <p><span class="muted">Newer</span> <a class="link" href={`/posts/${newer.id}`}>{newer.data.title}</a></p>
    )}
    <p><span class="muted">All</span> <a class="link" href="/archives">Everything I’ve written</a></p>
  </nav>
</BaseLayout>

<style>
  .post-head {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    margin-bottom: 2.5rem;
  }

  .post-title {
    font-size: clamp(1.9rem, 4.2vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .post-dek {
    margin-top: 0.9rem;
    font-style: italic;
    color: var(--ink-2);
  }

  .post-meta {
    margin-top: 1.4rem;
    color: var(--ink-3);
    font-variant-numeric: lining-nums;
    display: grid;
    gap: 0.35rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.8rem;
  }

  .tags a {
    transition: color 0.2s ease;
  }

  .tags a:hover {
    color: var(--c);
  }

  .swatch {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.4em;
    border-radius: 1px;
    background: var(--c);
    vertical-align: 0.08em;
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  /* Wide screens: the post's details sit in the margin beside the title */
  @media (min-width: 1100px) {
    .post-head {
      position: relative;
    }

    .post-meta {
      position: absolute;
      top: clamp(2.5rem, 7vw, 5rem);
      left: calc(var(--measure) + var(--gap));
      width: var(--margin);
      margin-top: 0.55rem;
    }

    .tags {
      flex-direction: column;
    }
  }

  .post-nav {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 0.5rem;
  }

  .post-nav .muted {
    display: inline-block;
    min-width: 3.5rem;
  }
</style>
