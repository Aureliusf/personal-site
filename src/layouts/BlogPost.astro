---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'posts'>['data'] & {
  slug: string;
};

const { title, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={title}>
  <article class="max-w-3xl mx-auto">
    <!-- Post Header -->
    <header class="mb-8 pb-6 border-b border-[var(--border)]">
      <h1 class="text-2xl font-semibold mb-4 text-[var(--text-primary)]">{title}</h1>
      <div class="flex items-center gap-4 text-sm text-[var(--text-muted)] font-mono">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags && tags.length > 0 && (
          <span class="flex gap-2">
            {tags.map((tag) => (
              <a 
                href={`/tags/${tag}`} 
                class="text-[var(--accent)] hover:text-[var(--link-hover)] link-underline"
              >
                #{tag}
              </a>
            ))}
          </span>
        )}
      </div>
    </header>

    <!-- Post Content -->
    <div class="prose">
      <slot />
    </div>

    <!-- Post Footer -->
    <footer class="mt-12 pt-6 border-t border-[var(--border)]">
      <div class="flex items-center justify-between">
        <a 
          href="/archives" 
          class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] link-underline transition-colors"
        >
          ← Back to archives
        </a>
        <div class="flex gap-2">
          {tags && tags.length > 0 && tags.map((tag) => (
            <a 
              href={`/tags/${tag}`} 
              class="tag hover-scale"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
