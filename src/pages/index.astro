---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = (await getCollection('posts')).sort(
  (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const recentPosts = allPosts.slice(0, 4);
---

<BaseLayout title="Aurelio Florez">
  <section class="mb-12">
    <p class="text-lg leading-relaxed mb-4">
      Computer Science student with web development experience, focused on building
      products that users love. Currently exploring full-stack development and
      distributed systems.
    </p>
    <p class="text-lg leading-relaxed">
      I'm a hobbyist developer who loves working on small projects, tweaking my
      environment, and learning new technologies. I'm always looking for new
      challenges and opportunities to learn.
    </p>
  </section>

  <section>
    <h2 class="text-2xl font-serif mb-6">Recent Posts</h2>
    {recentPosts.map((post: CollectionEntry<'posts'>) => (
      <PostPreview post={post} />
    ))}
  </section>
</BaseLayout>