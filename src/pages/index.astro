---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import AboutContent from '../components/AboutContent.astro';
import PersonalityCard from '../components/PersonalityCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = (await getCollection('posts')).sort(
  (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredPosts = allPosts
  .filter((post: CollectionEntry<'posts'>) => post.data.featured)
  .slice(0, 4);

const featuredPostData = featuredPosts.map((post: CollectionEntry<'posts'>) => {
  const year = post.data.date.getFullYear();
  const tags = post.data.tags || [];
  const techStack = tags.slice(0, 3).join(' + ');
  const meta = `${year} ${techStack ? '· ' + techStack : ''}`;
  return {
    slug: post.id,
    title: post.data.title,
    meta: meta,
    highlight: post.data.highlight,
    github: post.data.github
  };
});

const featuredSlugs = new Set(featuredPosts.map((p: CollectionEntry<'posts'>) => p.id));
const recentPosts = allPosts
  .slice(0, 10);

const allTags = allPosts
  .flatMap((post: CollectionEntry<'posts'>) => post.data.tags || [])
  .filter((tag): tag is string => tag !== null && tag !== undefined)
  .filter((tag) => tag !== 'featured');

const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const uniqueTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag]) => tag);
---

<BaseLayout title="Aurelio Florez | AI and Operations Engineer">
  <section class="mb-12 pb-8 border-b border-[var(--border)]">
    <div>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h1 class="text-2xl font-semibold text-[var(--text-primary)]">
          <span class="radar-name">Aurelio Florez</span>
        </h1>
        <button data-card-trigger type="button" aria-haspopup="dialog" class="hero-card-chip">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="15" rx="1" />
            <circle cx="8" cy="10.75" r="2.25" />
            <path d="M4.75 16.5c.7-1.8 1.9-2.6 3.25-2.6s2.55.8 3.25 2.6" />
            <path d="M14.5 9.5h4.75M14.5 12.5h4.75M14.5 15.5h2.75" />
          </svg>
          <span>Personality Card</span>
        </button>
      </div>
      <p class="text-[var(--text-muted)] text-sm">
      <AboutContent compact={true} />
      </p>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-8">
      <section class="mb-12">
        <div class="flex items-center justify-between mb-6">
          <h2 class="section-header">Projects</h2>
          <a href="/projects" class="text-sm text-accent-pink hover:opacity-80 link-underline">
            View all →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="project-item card-hover hover-glow overflow-hidden">
            <a href="/posts/saradmcom-fashion-portfolio-site" class="block">
              <div class="aspect-[16/10] mb-3 -mx-4 -mt-4 overflow-hidden">
                <picture>
                  <source srcset="/images/webp/saradm-preview.webp" type="image/webp" />
                  <img 
                    src="/images/saradm-preview.png" 
                    alt="saradm.com preview"
                    class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="481"
                  />
                </picture>
              </div>
              <div class="project-title link-underline">Portfolio Site for Fashion Stylist</div>
              <div class="project-meta">Astro + Sanity CMS on Cloudflare</div>
              <div class="project-metrics">99.9% uptime · Lighthouse perf. 100</div>
            </a>
          </div>
          <div class="project-item card-hover hover-glow overflow-hidden">
            <a href="/posts/resumequiver" class="block">
              <div class="aspect-[16/10] mb-3 -mx-4 -mt-4 overflow-hidden">
                <picture>
                  <source srcset="/images/webp/resumequiver.webp" type="image/webp" />
                  <img 
                    src="/images/resumequiver-preview.png" 
                    alt="ResumeQuiver preview"
                    class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="481"
                  />
                </picture>
              </div>
              <div class="project-title link-underline">ResumeQuiver</div>
              <div class="project-meta">TypeScript + React + Vercel</div>
              <div class="project-metrics">YAML-based · BYOK AI</div>
            </a>
          </div>
        </div>
      </section>

      {featuredPostData.length > 0 && (
        <section class="mb-12">
          <h2 class="section-header mb-6">Featured Posts</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {featuredPostData.map((item) => (
              <div class="project-item card-hover hover-glow relative">
                <a href={`/posts/${item.slug}`} class="block">
                  <div class="project-title link-underline">
                    {item.title}
                  </div>
                  <div class="project-meta">{item.meta}</div>
                  {item.highlight && (
                    <div class="project-metrics">{item.highlight}</div>
                  )}
                </a>
                {item.github && (
                  <a href={item.github} target="_blank" rel="noopener noreferrer" class="project-github hover:text-[var(--accent)] transition-colors mt-2 inline-flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    <span class="text-xs">{item.github.replace('https://github.com/', '')}</span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="section-header">Recent Posts</h2>
          <a href="/archives" class="text-sm text-accent-pink hover:opacity-80 link-underline">
            View all →
          </a>
        </div>
        <div class="border-t border-[var(--border)]">
          {recentPosts.map((post: CollectionEntry<'posts'>) => (
            <PostPreview post={post} />
          ))}
        </div>
      </section>
    </div>

    <aside class="lg:col-span-4 space-y-8">
      <section class="content-block card-hover">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-4 pb-2 border-b border-[var(--border)]">
          Technologies
        </h3>
        <div class="flex flex-wrap gap-2">
          {uniqueTags.map((skill) => (
            <a href={`/tags/${skill}`} class="tag hover-scale">{skill}</a>
          ))}
        </div>
      </section>
    </aside>
  </div>

  <!-- Personality card pop-out modal -->
  <div class="card-modal" data-card-modal role="dialog" aria-modal="true" aria-hidden="true" aria-label="Aurelio Florez — personality card">
    <div class="card-modal-backdrop" data-card-backdrop></div>
    <div class="card-modal-panel">
      <PersonalityCard bare>
        <button
          slot="actions"
          data-card-close
          type="button"
          aria-label="Close personality card"
          class="card-close"
        >✕</button>
      </PersonalityCard>
    </div>
  </div>
</BaseLayout>

<style>
  /* Sleek hero trigger chip */
  .hero-card-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-card-chip:hover {
    color: var(--accent-pink);
    border-color: var(--accent-pink);
    transform: translateY(-1px);
    box-shadow: 0 2px 12px rgba(236, 72, 153, 0.12);
  }

  .hero-card-chip:active {
    transform: translateY(0);
  }

  /* Pop-out modal */
  .card-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 2.5rem 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.16s ease, visibility 0.16s;
  }

  .card-modal.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .card-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(9, 10, 12, 0.78);
    backdrop-filter: blur(3px);
  }

  /* The "pop": scale + slight rotation with an overshooting bezier,
     plus a focus blur for a fluid depth effect — kept snappy. */
  .card-modal-panel {
    position: relative;
    transform: scale(0.86) rotate(-4deg) translateY(12px);
    filter: blur(5px);
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.16s ease;
  }

  .card-modal.open .card-modal-panel {
    transform: scale(1) rotate(0deg) translateY(0);
    filter: blur(0);
    animation: panelFloat 8s ease-in-out 0.45s infinite;
  }

  /* Gentle idle float while popped out — the card never sits still */
  @keyframes panelFloat {
    0%,
    100% {
      transform: scale(1) rotate(0deg) translateY(0);
    }
    50% {
      transform: scale(1) rotate(0deg) translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-modal-panel {
      transform: none;
      filter: none;
      transition: none;
    }

    .card-modal.open .card-modal-panel {
      animation: none;
    }
  }

  /* Close ✕ — styled as one of the card's own registration crosses,
     sitting in the title row of the card. */
  .card-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    line-height: 1;
    color: rgba(240, 243, 247, 0.45);
    background: transparent;
    border: none;
    cursor: pointer;
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: color 0.2s ease, text-shadow 0.2s ease, transform 0.2s ease;
  }

  .card-close:hover {
    color: var(--accent-pink);
    text-shadow: 0 0 10px rgba(236, 72, 153, 0.45);
    transform: rotate(90deg);
  }

  .card-close:focus-visible {
    outline: 1px solid var(--accent-pink);
    outline-offset: 2px;
  }
</style>

<script>
  const modal = document.querySelector('[data-card-modal]');
  const trigger = document.querySelector('[data-card-trigger]');
  const closeBtn = modal?.querySelector('[data-card-close]');
  const backdrop = modal?.querySelector('[data-card-backdrop]');
  let lastFocus: HTMLElement | null = null;

  const openModal = () => {
    if (!modal || modal.classList.contains('open')) return;
    lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden'; // lock page scroll while popped out
    if (closeBtn instanceof HTMLElement) closeBtn.focus();
  };

  const closeModal = () => {
    if (!modal || !modal.classList.contains('open')) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lastFocus?.focus();
  };

  // Clicking the hero chip pops the card out.
  trigger?.addEventListener('click', openModal);

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('open')) return;
    if (e.key === 'Escape') {
      closeModal();
      return;
    }
    if (e.key === 'Tab') {
      // Minimal focus trap inside the dialog
      const focusables = modal.querySelectorAll<HTMLElement>('a[href], button');
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
