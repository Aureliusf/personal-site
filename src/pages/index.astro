---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import AboutContent from '../components/AboutContent.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = (await getCollection('posts')).sort(
  (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredPosts = allPosts
  .filter((post: CollectionEntry<'posts'>) => post.data.featured)
  .slice(0, 4);

const featuredPostData = featuredPosts.map((post: CollectionEntry<'posts'>) => {
  const year = post.data.date.getFullYear();
  const tags = post.data.tags || [];
  const techStack = tags.slice(0, 3).join(' + ');
  const meta = `${year} ${techStack ? '· ' + techStack : ''}`;
  return {
    slug: post.slug,
    title: post.data.title,
    meta: meta,
    highlight: post.data.highlight,
    github: post.data.github
  };
});

const featuredSlugs = new Set(featuredPosts.map((p: CollectionEntry<'posts'>) => p.slug));
const recentPosts = allPosts
  .slice(0, 10);

const allTags = allPosts
  .flatMap((post: CollectionEntry<'posts'>) => post.data.tags || [])
  .filter((tag): tag is string => tag !== null && tag !== undefined)
  .filter((tag) => tag !== 'featured');

const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const uniqueTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([tag]) => tag);
---

<BaseLayout title="Aurelio Florez">
  <section class="mb-12 pb-8 border-b border-[var(--border)]">
    <div class="max-w-3xl">
      <h1 class="text-2xl font-semibold mb-4 text-[var(--text-primary)]">
        Developer & Computer Science Student
      </h1>
      <p class="text-[var(--text-secondary)] leading-relaxed mb-4">
        Shipping production systems with 99.99% uptime. I bridge TypeScript/React applications with NixOS/Docker infrastructure to build reliable, maintainable platforms.
      </p>
      <p class="text-[var(--text-muted)] text-sm">
      Open to internship opportunities in engineering and infrastructure roles.
      </p>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-8">
      {featuredPostData.length > 0 && (
        <section class="mb-12">
          <h2 class="section-header mb-6">Featured Projects</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {featuredPostData.map((item) => (
              <div class="project-item card-hover hover-glow relative">
                <a href={`/posts/${item.slug}`} class="block">
                  <div class="project-title link-underline">
                    {item.title}
                  </div>
                  <div class="project-meta">{item.meta}</div>
                  {item.highlight && (
                    <div class="project-metrics">{item.highlight}</div>
                  )}
                </a>
                {item.github && (
                  <a href={item.github} target="_blank" rel="noopener noreferrer" class="project-github hover:text-[var(--accent)] transition-colors mt-2 inline-flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    <span class="text-xs">{item.github.replace('https://github.com/', '')}</span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="section-header">Recent Posts</h2>
          <a href="/archives" class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] link-underline transition-colors">
            View all →
          </a>
        </div>
        <div class="border-t border-[var(--border)]">
          {recentPosts.map((post: CollectionEntry<'posts'>) => (
            <PostPreview post={post} />
          ))}
        </div>
      </section>
    </div>

    <aside class="lg:col-span-4 space-y-8">
      <AboutContent compact={true} />

      <section class="content-block card-hover">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-4 pb-2 border-b border-[var(--border)]">
          Tech Stack
        </h3>
        <div class="flex flex-wrap gap-2">
          {uniqueTags.map((skill) => (
            <a href={`/tags/${skill}`} class="tag hover-scale">{skill}</a>
          ))}
        </div>
      </section>

      <section class="content-block card-hover">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-4 pb-2 border-b border-[var(--border)]">
          Connect
        </h3>
        <div class="space-y-2 text-sm">
          <a href="https://github.com/aureliusf" class="block text-[var(--text-secondary)] hover:text-[var(--accent)] link-underline transition-colors" target="_blank" rel="noopener noreferrer">
            github.com/aureliusf
          </a>
          <a href="https://www.linkedin.com/in/aurelioflorez/" class="block text-[var(--text-secondary)] hover:text-[var(--accent)] link-underline transition-colors" target="_blank" rel="noopener noreferrer">
            linkedin.com/in/aurelioflorez
          </a>
          <a href="/resume.pdf" class="block text-[var(--text-secondary)] hover:text-[var(--accent)] link-underline transition-colors">
            Download Resume
          </a>
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>
