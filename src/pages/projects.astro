---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  name: string;
  url: string;
  description: string;
  highlights: string[];
  techStack: string[];
  github?: string;
  preview?: string;
}

const projects: Project[] = [
  {
    name: "saradm.com",
    url: "/posts/saradm-com-fashion-portfolio-site",
    description: "Fashion portfolio with custom Sanity CMS and serverless contact form.",
    highlights: [
      "99.9% uptime",
      "100 Lighthouse"
    ],
    techStack: ["Astro", "React", "Sanity", "Cloudflare"],
    github: "https://github.com/Aureliusf/astro-saradm",
    preview: "/images/saradm-preview.png"
  },
  {
    name: "ResumeQuiver",
    url: "/posts/resumequiver",
    description: "Privacy-first YAML resume builder with AI copywriting and PDF export.",
    highlights: [
      "BYOK AI",
      "Privacy-first"
    ],
    techStack: ["TypeScript", "React", "Vercel", "Sentry"],
    github: "https://github.com/Aureliusf/resumequiver",
    preview: "/images/resumequiver-preview.png"
  }
];
---

<BaseLayout title="Projects | Aurelio Florez" description="A showcase of web development projects by Aurelio Florez">
  <section class="mb-8 pb-6 border-b border-[var(--border)]">
    <h1 class="text-2xl font-semibold mb-3 text-[var(--text-primary)]">
      <span class="radar-name">Projects</span>
    </h1>
    <p class="text-[var(--text-muted)] text-sm">
      Production-ready applications built for real users.
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {projects.map((project) => (
      <article class="content-block card-hover group flex flex-col overflow-hidden">
        <a 
          href={project.url}
          class="block relative -mx-4 -mt-4 mb-4 aspect-[16/10] overflow-hidden bg-[var(--bg-tertiary)]"
        >
          {project.preview ? (
            <img 
              src={project.preview} 
              alt={`${project.name} preview`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-3xl opacity-20">
                {project.name === "saradm.com" ? "👗" : "📄"}
              </span>
            </div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)]/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
        </a>

        <div class="flex items-center justify-between mb-2">
          <h2 class="text-base font-semibold text-[var(--text-primary)]">
            <a 
              href={project.url}
              class="link-underline hover:text-[var(--accent)] transition-colors"
            >
              {project.name}
            </a>
          </h2>
          <span class="text-[var(--accent-emerald)] text-xs">●</span>
        </div>
        
        <p class="text-[var(--text-secondary)] text-sm mb-3 leading-relaxed flex-1">
          {project.description}
        </p>

        <div class="flex flex-wrap gap-1.5 mb-3">
          {project.techStack.map((tech) => (
            <span class="tag text-xs">{tech}</span>
          ))}
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-[var(--border)]">
          <div class="flex gap-3 text-xs">
            {project.highlights.map((highlight) => (
              <span class="text-[var(--accent-amber)] font-mono">{highlight}</span>
            ))}
          </div>
          
          {project.github && (
            <a 
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors"
              title="Source"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
          )}
        </div>
      </article>
    ))}
    
    <a 
      href="https://github.com/aureliusf"
      target="_blank"
      rel="noopener noreferrer"
      class="content-block card-hover group flex flex-col items-center justify-center text-center p-6 min-h-[280px]"
    >
      <svg class="w-8 h-8 text-[var(--text-muted)] mb-3 group-hover:text-[var(--accent)] transition-colors" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      <span class="text-sm font-medium text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] transition-colors">
        More on GitHub
      </span>
      <span class="text-xs text-[var(--text-muted)] mt-1">
        github.com/aureliusf
      </span>
    </a>
  </div>


</BaseLayout>
