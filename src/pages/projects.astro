---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/agent-profile';
import { isExternal, projectImages, shortTitle, sortedPosts } from '../data/site';

const profileLinks = new Set(profile.projects.flatMap((p) => (p.links ?? []).map((l) => l.url)));

const status = (p: { name: string; visibility?: string }) =>
  p.name.includes('Langfuse') ? 'retired' : p.visibility === 'private' ? 'private' : 'public';

// The profile is written in the third person for agents; this page speaks as me.
const firstPerson = (line: string) => line.replace('how Aurelio scopes', 'how I scope');

// Side projects: posts that ship code and aren't covered above.
const side = (await sortedPosts())
  .filter((post) => post.data.github && !profileLinks.has(post.data.github))
  .map((post) => ({
    name: shortTitle(post.data.title),
    description: post.data.description ?? '',
    year: post.data.date.getUTCFullYear(),
    href: `/posts/${post.id}`,
    github: post.data.github!,
    liveUrl: post.data.liveUrl,
  }));
---

<BaseLayout title="Work · Aurelio Florez" description="Systems and side projects by Aurelio Florez, with what each one measured.">
  <div class="col intro">
    <h1 class="page-title">Work</h1>
    <p class="muted">
      Systems and side projects, including one that didn’t make it. What each one measured sits beside
      it. My work at Melody AV and i4nm is on the <a class="link" href="/">front page</a>
      and in the <a class="link" href="/resume.pdf">résumé</a>.
    </p>
  </div>

  {profile.projects.map((project, i) => {
    const image = projectImages[project.name];
    return (
      <section class="project" aria-labelledby={`p-${i}`}>
        <div class="project-text">
          <h2 id={`p-${i}`}>{project.name}</h2>
          <p class="kicker small"><span class="caps">{status(project)}</span> · {project.technologies.join(', ')}</p>
          <p>{project.description}</p>
          {project.links && (
            <p class="small links">
              {project.links.map((link) => (
                <a class="link" href={link.url} rel={isExternal(link.url) ? 'noopener noreferrer' : undefined}>{link.label}</a>
              ))}
            </p>
          )}
        </div>
        <ul class="evidence small" aria-label={`What ${project.name} measured`}>
          {project.evidence.map((line) => <li>{firstPerson(line)}.</li>)}
        </ul>
        {image && (
          <figure class="shot">
            <picture>
              <source srcset={image.webp} type="image/webp" />
              <img src={image.src} alt={image.alt} width="800" height="481" loading="lazy" decoding="async" />
            </picture>
          </figure>
        )}
      </section>
    );
  })}

  <section class="col side" aria-labelledby="side">
    <h2 id="side">Smaller things</h2>
    <p class="muted small">Weekend-sized projects. Each has source and a write-up.</p>
    <ul>
      {side.map((p) => (
        <li>
          <p>
            <a class="link name" href={p.href}>{p.name}</a>
            <span class="muted small figures">{p.year}</span>
          </p>
          <p class="small desc">{p.description}</p>
          <p class="small links">
            {p.liveUrl && <a class="link" href={p.liveUrl} rel="noopener noreferrer">Live</a>}
            <a class="link" href={p.github} rel="noopener noreferrer">Source</a>
          </p>
          {projectImages[p.name] && (
            <figure class="shot">
              <picture>
                <source srcset={projectImages[p.name].webp} type="image/webp" />
                <img src={projectImages[p.name].src} alt={projectImages[p.name].alt} width="800" height="481" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .intro > * + * {
    margin-top: 1rem;
  }

  .page-title {
    font-size: clamp(1.9rem, 4.2vw, 2.6rem);
  }

  .project,
  .side {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
    max-width: calc(var(--measure) + var(--gap) + var(--margin));
  }

  .side > * {
    max-width: var(--measure);
  }

  .project {
    display: grid;
    gap: 1.25rem var(--gap);
  }

  .project-text {
    max-width: var(--measure);
  }

  .evidence {
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
    max-width: var(--measure);
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .evidence li + li {
    margin-top: 0.5rem;
  }

  @media (min-width: 1100px) {
    .project {
      grid-template-columns: var(--measure) var(--margin);
    }

    .evidence {
      padding-left: 0;
      border-left: 0;
      padding-top: 0.35rem;
    }

    .project .shot {
      grid-column: 1 / -1;
    }
  }

  .project h2,
  .side h2 {
    font-size: 1.4rem;
  }

  .kicker {
    margin-top: 0.3rem;
    margin-bottom: 0.9rem;
    color: var(--ink-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.2rem;
    margin-top: 0.8rem;
  }

  .shot {
    margin-top: 0.75rem;
  }

  .side .shot {
    margin-top: 1.25rem;
  }

  .shot img {
    width: 100%;
    height: auto;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 10px 30px -14px rgba(0, 0, 0, 0.3);
  }

  .side ul {
    margin-top: 1.25rem;
  }

  .side li + li {
    margin-top: 1.75rem;
  }

  .side .name {
    font-weight: 600;
    margin-right: 0.5rem;
  }

  .desc {
    margin-top: 0.2rem;
    color: var(--ink-2);
  }
</style>
