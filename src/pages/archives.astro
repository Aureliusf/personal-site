---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import Topics from '../components/Topics.astro';
import type { CollectionEntry } from 'astro:content';
import { pullQuotes, sortedPosts } from '../data/site';

const allPosts = await sortedPosts();

const postsByYear = allPosts.reduce<Record<string, CollectionEntry<'posts'>[]>>((acc, post) => {
  const year = post.data.date.getUTCFullYear().toString();
  (acc[year] ??= []).push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Writing · Aurelio Florez" description="Posts by Aurelio Florez on AI agents, self-hosting, NixOS, and the things he builds.">
  <div class="col intro">
    <h1 class="page-title">Writing</h1>
    <p class="muted">
      Notes from building things: what agents cost, self-hosting, NixOS, and write-ups of projects. Also by
      <a class="link" href="/rss.xml">RSS</a>.
    </p>
    <Topics posts={allPosts} />
  </div>

  {years.map((year) => (
    <section class="col year" aria-labelledby={`y-${year}`}>
      <h2 id={`y-${year}`} class="year-title">{year}</h2>
      <div>
        {postsByYear[year].map((post) => <PostPreview post={post} dateStyle="short" quote={pullQuotes[post.id]} />)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .intro > * + * {
    margin-top: 1rem;
  }

  .page-title {
    font-size: clamp(1.9rem, 4.2vw, 2.6rem);
  }

  .year {
    margin-top: 3rem;
  }

  .year-title {
    font-size: 1rem;
    font-variant-numeric: lining-nums;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
</style>
