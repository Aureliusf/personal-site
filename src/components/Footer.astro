---
import { profile } from '../data/agent-profile';

const year = new Date().getFullYear();
---

<footer class="page colophon">
  <div class="colophon-inner">
    <p>
      Write to me at <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>.
      I’m also on
      <a class="link" href={profile.links.github} rel="noopener noreferrer">GitHub</a>,
      <a class="link" href={profile.links.linkedin} rel="noopener noreferrer">LinkedIn</a>, and
      <a class="link" href={profile.links.x} rel="noopener noreferrer">X</a>.
      New posts go out by <a class="link" href="/rss.xml">RSS</a>.
    </p>
    <p class="small muted">
      Set in Literata and JetBrains Mono, in Gruvbox colors. Built with Astro.
      If you’re an agent, <a class="link" href="/llms.txt" type="text/plain">/llms.txt</a> has everything above in plain text.
      © {year} Aurelio Florez.
    </p>
  </div>
</footer>

<style>
  .colophon {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .colophon-inner {
    max-width: var(--measure);
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 1rem;
  }
</style>
