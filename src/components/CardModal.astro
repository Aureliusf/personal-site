---
import PersonalityCard from './PersonalityCard.astro';

/**
 * Pop-out for the personality card (from PR #74). Any element with
 * [data-card-trigger] on the page opens it.
 */
---

<dialog class="card-modal" data-card-modal aria-label="Aurelio Florez, personality card">
  <div class="card-modal-backdrop" data-card-backdrop></div>
  <div class="card-modal-stage" data-card-stage>
    <div class="card-fly" data-card-fly>
      <div class="card-float" data-card-float>
        <PersonalityCard bare />
      </div>
    </div>
    <div class="card-controls" data-card-controls>
      <span class="card-hint">
        <span class="card-hint-pointer">Drag to spin · Esc to close</span>
        <span class="card-hint-touch">Swipe to spin · Tilt your phone</span>
      </span>
      <button data-card-close type="button" class="card-close" autofocus>
        <span aria-hidden="true">✕</span> Close
      </button>
    </div>
  </div>
</dialog>

<style>
  /* Full-viewport, transparent dialog; it draws its own backdrop so the
     backdrop can fade in step with the card. */
  .card-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    /* Grows on large desktops, always fits phones and short screens */
    --pc-width: min(max(360px, 26vw), 520px, 84vw, calc((100dvh - 8rem) * 5 / 7));
  }

  .card-modal::backdrop {
    background: transparent;
  }

  :global(html.card-open) {
    overflow: hidden;
  }

  .card-modal-backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 45%, rgba(80, 73, 69, 0.4), transparent 60%),
      rgba(29, 32, 33, 0.86);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .card-modal-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    height: 100%;
    padding: 1.5rem;
  }

  .card-fly {
    will-change: transform;
  }

  /* Gentle idle float once the card has landed */
  .card-float.is-landed {
    animation: cardFloat 7s ease-in-out infinite;
  }

  @keyframes cardFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .card-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(235, 219, 178, 0.55);
  }

  .card-hint-pointer {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .card-hint-pointer {
      display: inline;
    }

    .card-hint-touch {
      display: none;
    }
  }

  .card-close {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: rgba(235, 219, 178, 0.8);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(235, 219, 178, 0.2);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .card-close:hover,
  .card-close:focus-visible {
    color: #fbf1c7;
    border-color: #fe8019;
    background: rgba(254, 128, 25, 0.1);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-float.is-landed {
      animation: none;
    }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-card-modal]');
  const triggers = [...document.querySelectorAll<HTMLElement>('[data-card-trigger]')];

  if (modal && triggers.length) {
    const fly = modal.querySelector<HTMLElement>('[data-card-fly]')!;
    const float = modal.querySelector<HTMLElement>('[data-card-float]')!;
    const backdrop = modal.querySelector<HTMLElement>('[data-card-backdrop]')!;
    const controls = modal.querySelector<HTMLElement>('[data-card-controls]')!;
    const closeBtn = modal.querySelector<HTMLButtonElement>('[data-card-close]')!;
    const card = modal.querySelector<HTMLElement>('[data-personality-card]')!;
    const portrait = card.querySelector<HTMLImageElement>('img')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Warm the portrait before the first open so the card never pops in empty.
    const preload = () => {
      portrait.loading = 'eager';
    };
    triggers.forEach((trigger) =>
      ['pointerenter', 'focus', 'touchstart'].forEach((type) =>
        trigger.addEventListener(type, preload, { once: true, passive: true }),
      ),
    );
    window.addEventListener('load', () => setTimeout(preload, 1500), { once: true });

    let lastFocus: HTMLElement | null = null;
    let closing = false;

    const openModal = async () => {
      if (modal.open) return;
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      preload();
      await Promise.race([portrait.decode().catch(() => {}), new Promise((r) => setTimeout(r, 150))]);

      card.dispatchEvent(new Event('pc:reset'));
      modal.showModal();
      document.documentElement.classList.add('card-open');
      closeBtn.focus({ preventScroll: true });

      if (reduceMotion) {
        modal.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 150 });
        return;
      }

      const enter = { duration: 220, easing: 'cubic-bezier(0.2, 0, 0, 1)' };
      backdrop.animate([{ opacity: 0 }, { opacity: 1 }], enter);
      controls.animate([{ opacity: 0 }, { opacity: 1 }], enter);
      fly
        .animate([{ transform: 'translateY(10px) rotate(-3deg) scale(0.96)', opacity: 0 }, { transform: 'none', opacity: 1 }], enter)
        .finished.then(() => float.classList.add('is-landed'))
        .catch(() => {});
    };

    // Runs however the dialog ends up closed.
    const cleanUp = () => {
      closing = false;
      float.classList.remove('is-landed');
      document.documentElement.classList.remove('card-open');
      fly.getAnimations().forEach((a) => a.cancel());
      lastFocus?.focus({ preventScroll: true });
    };

    const closeModal = async () => {
      if (!modal.open || closing) return;
      closing = true;

      if (!reduceMotion) {
        float.classList.remove('is-landed');
        const leave = { duration: 150, easing: 'ease-in', fill: 'forwards' as const };
        backdrop.animate([{ opacity: 1 }, { opacity: 0 }], leave);
        controls.animate([{ opacity: 1 }, { opacity: 0 }], leave);
        await fly
          .animate([{ transform: 'none', opacity: 1 }, { transform: 'scale(0.97)', opacity: 0 }], leave)
          .finished.catch(() => {});
      }

      modal.close();
      [backdrop, controls].forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
    };

    triggers.forEach((trigger) => trigger.addEventListener('click', openModal));
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('close', cleanUp);

    // Esc: play the close animation instead of vanishing.
    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    });

    // Clicks outside the card close it, but not the end of a drag that
    // started on the card and wandered off.
    let downOutside = false;
    modal.addEventListener('pointerdown', (e) => {
      downOutside = !(e.target as Element).closest('[data-personality-card], [data-card-controls]');
    });
    modal.addEventListener('click', (e) => {
      if (downOutside && !(e.target as Element).closest('[data-personality-card], [data-card-controls]')) {
        closeModal();
      }
      downOutside = false;
    });
  }
</script>
