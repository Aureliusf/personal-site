---
import { profile } from '../data/agent-profile.ts';

interface Props {
  /** Bare mode: render just the card, without the dark stage box
   * (used when the card pops out over a backdrop). */
  bare?: boolean;
}

const { bare = false } = Astro.props;

/**
 * Personality card — dark graphite trading card in the style of
 * vgpu.sh/examples/holographic-card, with the picture on top and no
 * holographic element. Facts come from src/data/agent-profile.ts.
 */

// Picture shown on top of the card. Optimized copies of Profile.png
// (800×800) live in public/images/.
const picture = '/images/profile-fallback.png';
const pictureWebp = '/images/profile.webp';

// Facts — every value is pulled from the profile, nothing hard-coded.
const facts = [
  { label: 'Location', value: profile.location },
  { label: 'Focus', value: profile.focus[0] },
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { label: 'Status', value: profile.availability },
];
---

<div class:list={["pc-stage", bare && "pc-stage--none"]}>
  <article class="personality-card" data-personality-card>
    <span class="pc-triangle" aria-hidden="true">
      <svg viewBox="0 0 100 100" fill="none" stroke="#b3b8c2" stroke-width="1">
        <polygon points="50,6 96,92 4,92" />
      </svg>
    </span>

    <div class="pc-inner">
      <header class="pc-title-header">
        <h2 class="pc-title">{profile.name}</h2>
        {bare && <slot name="actions" />}
      </header>

      <figure class="pc-picture">
        <span class="pc-tick pc-tick--tl" aria-hidden="true"></span>
        <span class="pc-tick pc-tick--tr" aria-hidden="true"></span>
        <span class="pc-tick pc-tick--bl" aria-hidden="true"></span>
        <span class="pc-tick pc-tick--br" aria-hidden="true"></span>
        <picture>
          <source srcset={pictureWebp} type="image/webp" />
          <img src={picture} alt={`Portrait of ${profile.name}`} loading="lazy" decoding="async" />
        </picture>
      </figure>

      <p class="pc-headline">{profile.headline}</p>

      <dl class="pc-facts">
        {facts.map((fact) => (
          <div class="pc-fact">
            <dt class="pc-fact-key">{fact.label}</dt>
            <dd class="pc-fact-val">
              {fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}
            </dd>
          </div>
        ))}
      </dl>

      <div class="pc-bottom">
        <span class="pc-cross" aria-hidden="true">✕</span>
        <p class="pc-hint">Hover to tilt</p>
        <span class="pc-cross" aria-hidden="true">✕</span>
      </div>
    </div>
  </article>
</div>

<style>
  /* Dark stage around the card, like the reference page background. */
  .pc-stage {
    position: relative;
    padding: 2.5rem 1.5rem;
    background: #090a0c;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .pc-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.045) 0.5px, transparent 0.6px);
    background-size: 18px 18px;
    pointer-events: none;
  }

  /* Brushed-metal card body — always dark, like the reference card. */
  .personality-card {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    background:
      /* Diagonal metallic sheen bands */
      linear-gradient(
        115deg,
        rgba(255, 255, 255, 0.085) 0%,
        rgba(255, 255, 255, 0.02) 26%,
        rgba(255, 255, 255, 0) 46%,
        rgba(255, 255, 255, 0.025) 66%,
        rgba(255, 255, 255, 0.075) 100%
      ),
      /* Fine brushed-grain lines */
      repeating-linear-gradient(
        92deg,
        rgba(255, 255, 255, 0.03) 0 1px,
        rgba(255, 255, 255, 0) 1px 3px
      ),
      /* Metal base — polished graphite with ridges */
      linear-gradient(
        170deg,
        #2b2e35 0%,
        #1b1d23 16%,
        #14161b 40%,
        #1a1c22 58%,
        #101216 78%,
        #191b21 100%
      );
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55),
      inset 1px 0 0 rgba(255, 255, 255, 0.06),
      inset -1px 0 0 rgba(0, 0, 0, 0.35),
      0 24px 60px rgba(0, 0, 0, 0.6);
    will-change: transform;
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
    overflow: hidden;
  }

  .personality-card:hover {
    border-color: rgba(255, 255, 255, 0.26);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55),
      inset 1px 0 0 rgba(255, 255, 255, 0.08),
      inset -1px 0 0 rgba(0, 0, 0, 0.35),
      0 28px 64px rgba(0, 0, 0, 0.65);
  }

  /* Sparse microdots in the card surround. */
  .personality-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0.5px, transparent 0.6px);
    background-size: 12px 12px;
    pointer-events: none;
  }

  /* Pointer light (plain lighting, not holographic). */
  .personality-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      rgba(228, 235, 245, 0.2),
      rgba(228, 235, 245, 0.055) 32%,
      transparent 62%
    );
    opacity: var(--light, 0);
    pointer-events: none;
    z-index: 3;
  }

  /* Bare mode (pop-out): the card floats on its own — no stage box,
     just a deeper drop shadow onto the backdrop. */
  /* Bare mode (pop-out): the card floats on its own — no stage box,
     just a deeper drop shadow onto the backdrop. */
  .pc-stage--none {
    display: contents;
  }

  .pc-stage--none::before {
    content: none;
  }

  .pc-stage--none .personality-card {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55),
      inset 1px 0 0 rgba(255, 255, 255, 0.06),
      inset -1px 0 0 rgba(0, 0, 0, 0.35),
      0 18px 40px rgba(0, 0, 0, 0.5),
      0 48px 110px rgba(0, 0, 0, 0.75);
  }

  .pc-stage--none .personality-card:hover {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.55),
      inset 1px 0 0 rgba(255, 255, 255, 0.08),
      inset -1px 0 0 rgba(0, 0, 0, 0.35),
      0 20px 44px rgba(0, 0, 0, 0.55),
      0 52px 120px rgba(0, 0, 0, 0.8);
  }

  .pc-triangle {
    position: absolute;
    right: -1.4rem;
    bottom: -1.4rem;
    width: 84px;
    height: 84px;
    opacity: 0.22;
    pointer-events: none;
    z-index: 2;
  }

  .pc-triangle svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pc-inner {
    position: relative;
    padding: 1rem 1.25rem 1.1rem;
  }

  /* Card title — the name, engraved into the metal at the top. */
  .pc-title-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }

  .pc-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f3f5f8;
    text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.6), 0 1px 0 rgba(255, 255, 255, 0.14);
    margin: 0;
    line-height: 1.35;
  }

  /* Picture on top with registration-tick framing marks. */
  .pc-picture {
    position: relative;
    margin: 0;
    border: 1px solid transparent;
    /* No fill — transparent cutouts reveal the brushed metal behind. */
    background:
      linear-gradient(
          160deg,
          rgba(255, 255, 255, 0.42),
          rgba(255, 255, 255, 0.08) 38%,
          rgba(0, 0, 0, 0.5) 72%,
          rgba(255, 255, 255, 0.28)
        )
        border-box;
  }

  .pc-picture img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .pc-picture::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pc-tick {
    position: absolute;
    width: 9px;
    height: 9px;
    pointer-events: none;
    z-index: 2;
  }

  .pc-tick--tl {
    top: -4px;
    left: -4px;
    border-top: 1px solid rgba(238, 240, 243, 0.45);
    border-left: 1px solid rgba(238, 240, 243, 0.45);
  }

  .pc-tick--tr {
    top: -4px;
    right: -4px;
    border-top: 1px solid rgba(238, 240, 243, 0.45);
    border-right: 1px solid rgba(238, 240, 243, 0.45);
  }

  .pc-tick--bl {
    bottom: -4px;
    left: -4px;
    border-bottom: 1px solid rgba(238, 240, 243, 0.45);
    border-left: 1px solid rgba(238, 240, 243, 0.45);
  }

  .pc-tick--br {
    bottom: -4px;
    right: -4px;
    border-bottom: 1px solid rgba(238, 240, 243, 0.45);
    border-right: 1px solid rgba(238, 240, 243, 0.45);
  }

  .pc-headline {
    font-size: 0.7rem;
    line-height: 1.55;
    color: rgba(238, 240, 243, 0.55);
    margin: 0.9rem 0 1rem;
  }

  .pc-facts {
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .pc-fact {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .pc-fact-key {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(238, 240, 243, 0.35);
  }

  .pc-fact-val {
    font-size: 0.7rem;
    line-height: 1.5;
    color: rgba(238, 240, 243, 0.8);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .pc-fact-val a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(236, 72, 153, 0.5);
    text-underline-offset: 2px;
  }

  .pc-fact-val a:hover {
    text-decoration-color: rgba(236, 72, 153, 0.9);
  }

  .pc-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .pc-cross {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: rgba(238, 240, 243, 0.4);
  }

  .pc-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.35);
    margin: 0;
  }
</style>

<script>
  // Pointer tilt — the card leans toward the pointer and settles back on
  // leave. No holographic reveal, just tilt + a soft pointer light.
  const cards = document.querySelectorAll<HTMLElement>('[data-personality-card]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  cards.forEach((card) => {
    if (reduceMotion) return;

    const maxTilt = 7; // degrees
    const lift = 6; // px — subtle scale/lift toward the pointer
    let raf = 0;
    let tiltX = 0, tiltY = 0, targetX = 0, targetY = 0;
    let liftZ = 0, targetLift = 0;
    let light = 0, targetLight = 0;

    const frame = () => {
      raf = 0;
      tiltX += (targetX - tiltX) * 0.08;
      tiltY += (targetY - tiltY) * 0.08;
      liftZ += (targetLift - liftZ) * 0.08;
      light += (targetLight - light) * 0.08;
      card.style.transform = `perspective(900px) rotateX(${tiltX.toFixed(3)}deg) rotateY(${tiltY.toFixed(3)}deg) translateZ(${liftZ.toFixed(2)}px)`;
      card.style.setProperty('--light', light.toFixed(3));
      if (
        Math.abs(targetX - tiltX) > 0.02 ||
        Math.abs(targetY - tiltY) > 0.02 ||
        Math.abs(targetLift - liftZ) > 0.02 ||
        Math.abs(targetLight - light) > 0.005
      ) {
        raf = requestAnimationFrame(frame);
      }
    };

    const start = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    card.addEventListener('pointermove', (e: PointerEvent) => {
      if (e.pointerType === 'touch') return; // keep page scroll on touch
      const rect = card.getBoundingClientRect();
      const px = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      const py = Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height));
      targetX = (0.5 - py) * maxTilt;
      targetY = (px - 0.5) * maxTilt;
      targetLift = lift;
      targetLight = 1;
      card.style.setProperty('--mx', `${(px * 100).toFixed(2)}%`);
      card.style.setProperty('--my', `${(py * 100).toFixed(2)}%`);
      start();
    });

    card.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
      targetLift = 0;
      targetLight = 0;
      start();
    });
  });
</script>
