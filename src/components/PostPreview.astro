---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../data/site';

type Props = {
  post: CollectionEntry<'posts'>;
  dateStyle?: 'month' | 'short';
  quote?: string;
};

const { post, dateStyle = 'month', quote } = Astro.props;
const { title, date } = post.data;
---

<a href={`/posts/${post.id}`} class="post-row">
  <span class="post-title">
    {title}
    {quote && <span class="post-quote">{quote}</span>}
  </span>
  <time datetime={date.toISOString()} class="post-date">{formatDate(date, dateStyle)}</time>
</a>

<style>
  .post-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .post-title {
    flex: 1;
    transition: color 0.2s ease;
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-quote {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--ink-3);
  }

  .post-date {
    flex: none;
    font-size: 0.875rem;
    color: var(--ink-3);
    font-variant-numeric: lining-nums tabular-nums;
  }

  @media (max-width: 520px) {
    .post-row {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
