---
/**
 * Opens the personality card pop-out (CardModal).
 * "margin": a small tilted card resting in the letter's margin (wide screens).
 * "ps": a postscript line with a thumbnail (narrow screens).
 */
interface Props {
  variant: 'margin' | 'ps';
}

const { variant } = Astro.props;
---

{variant === 'margin' ? (
  <div class="thumb-wrap">
    <button type="button" class="thumb" data-card-trigger aria-haspopup="dialog" aria-label="Open my personality card">
      <span class="thumb-name" aria-hidden="true">Aurelio Florez</span>
      <picture>
        <source srcset="/images/profile.webp" type="image/webp" />
        <img src="/images/profile-fallback.png" alt="" width="800" height="800" decoding="async" draggable="false" />
      </picture>
      <span class="thumb-tag" aria-hidden="true">AI + Ops</span>
    </button>
    <p class="thumb-caption">My card. Pick it up.</p>
  </div>
) : (
  <p class="ps">
    <button type="button" class="ps-thumb" data-card-trigger aria-haspopup="dialog" aria-label="Open my personality card">
      <picture>
        <source srcset="/images/profile.webp" type="image/webp" />
        <img src="/images/profile-fallback.png" alt="" width="800" height="800" loading="lazy" decoding="async" />
      </picture>
    </button>
    <span>
      P.S. <button type="button" class="ps-link" data-card-trigger aria-haspopup="dialog">Here’s my card</button>,
      if you’d rather flip through the short version.
    </span>
  </p>
)}

<style>
  /* Shared plate: the same Gruvbox card as PersonalityCard */
  .thumb,
  .ps-thumb {
    --t-plate-1: #f9f0cd;
    --t-plate-3: #e9d9a8;
    --t-fg: #282828;
    --t-fg-3: #7c6f64;
    --t-line: rgba(80, 73, 69, 0.18);
    --t-photo-1: #e6d5a8;
    --t-photo-2: #d5c4a1;
    --t-edge: rgba(80, 73, 69, 0.28);
    background: linear-gradient(165deg, var(--t-plate-1), var(--t-plate-3));
    box-shadow:
      inset 0 0 0 1px var(--t-edge),
      0 2px 3px rgba(40, 40, 40, 0.16),
      0 14px 28px -12px rgba(40, 40, 40, 0.45);
    cursor: pointer;
  }

  @media (prefers-color-scheme: dark) {
    .thumb,
    .ps-thumb {
      --t-plate-1: #3c3836;
      --t-plate-3: #282828;
      --t-fg: #fbf1c7;
      --t-fg-3: #a89984;
      --t-line: rgba(235, 219, 178, 0.14);
      --t-photo-1: #504945;
      --t-photo-2: #3c3836;
      --t-edge: rgba(0, 0, 0, 0.45);
    }
  }

  .thumb img,
  .ps-thumb img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: 50% 100%;
    -webkit-user-drag: none;
  }

  /* ---- Margin card ---- */
  .thumb-wrap {
    display: none;
  }

  @media (min-width: 1100px) {
    .thumb-wrap {
      display: block;
      float: right;
      clear: right;
      width: 8.5rem;
      margin: 0.6rem calc(var(--margin) - 8.5rem) 1rem var(--gap);
    }
  }

  .thumb {
    display: flex;
    flex-direction: column;
    width: 100%;
    aspect-ratio: 5 / 7;
    padding: 0.55rem 0.6rem 0.5rem;
    border-radius: 0.45rem;
    transform: rotate(-4deg);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease;
  }

  .thumb:hover,
  .thumb:focus-visible {
    transform: rotate(-1deg) translateY(-3px);
    box-shadow:
      inset 0 0 0 1px var(--t-edge),
      0 4px 6px rgba(40, 40, 40, 0.16),
      0 22px 36px -12px rgba(40, 40, 40, 0.45);
  }

  .thumb-name,
  .thumb-tag {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--t-fg);
    line-height: 1.3;
  }

  .thumb-tag {
    align-self: flex-end;
    font-weight: 400;
    color: var(--t-fg-3);
  }

  .thumb picture {
    flex: 1;
    display: flex;
    align-items: flex-end;
    margin: 0.35rem 0;
    min-height: 0;
    border: 1px solid var(--t-line);
    background: radial-gradient(ellipse at 50% 38%, var(--t-photo-1), var(--t-photo-2) 78%);
  }

  .thumb img {
    height: 100%;
  }

  .thumb-caption {
    margin-top: 0.8rem;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--ink-3);
  }

  /* ---- Postscript ---- */
  .ps {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem !important;
  }

  @media (min-width: 1100px) {
    .ps {
      display: none;
    }
  }

  .ps-thumb {
    flex: none;
    width: 3.4rem;
    aspect-ratio: 5 / 7;
    padding: 0.3rem;
    border-radius: 0.3rem;
    transform: rotate(-4deg);
    display: flex;
    align-items: flex-end;
  }

  .ps-thumb picture {
    display: block;
    width: 100%;
    background: radial-gradient(ellipse at 50% 38%, var(--t-photo-1), var(--t-photo-2) 78%);
  }

  .ps-link {
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    cursor: pointer;
  }

  .ps-link:hover {
    text-decoration-color: currentColor;
  }
</style>
